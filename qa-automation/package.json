{
  "name": "qa_automation_js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node ./scripts/qa.mjs",
    "test:collect": "node ./scripts/qa.mjs tests --collect-only",
    "test:generated": "node ./scripts/catalog-coverage.mjs --type workshop --require-nonzero && node ./scripts/catalog-coverage.mjs --type livestack --require-nonzero && node ./scripts/qa.mjs tests/generated/platform tests/generated/workshops tests/generated/livestacks tests/generated/platform/par/catalogParLinks.spec.ts",
    "test:generated:all-13": "node ./scripts/catalog-coverage.mjs --all-livestacks && node ./scripts/qa.mjs tests/generated/livestacks",
    "test:unit": "node --test ./tests/unit/catalog/*.test.mjs ./tests/unit/par/*.test.mjs ./tests/unit/runner/*.test.mjs ./tests/unit/reporting/*.test.mjs ./tests/unit/livestacks/*.test.mjs ./tests/unit/workshops/*.test.mjs",
    "test:unit:livestacks": "npm run test:unit:livestacks:framework && node ./scripts/livestack-unit.mjs",
    "test:unit:livestacks:framework": "node --test ./tests/unit/livestacks/*.test.mjs",
    "test:unit:livestack": "npm run test:unit:livestacks",
    "test:unit:livestack:framework": "npm run test:unit:livestacks:framework",
    "catalog:index": "node ./scripts/catalog-index.mjs",
    "review:retest": "node ./scripts/report-review-action.mjs retest",
    "review:fix": "node ./scripts/report-review-action.mjs fix",
    "test:review-lists": "node --test ./tests/unit/runner/report-review-action.test.mjs",
    "auth:storage": "node ./scripts/auth-storage-state.mjs",
    "doctor": "node ./scripts/qa.mjs doctor",
    "install:browsers": "playwright install",
    "playwright": "playwright",
    "report": "node ./scripts/qa.mjs report",
    "trace": "node ./scripts/qa.mjs trace",
    "codegen": "node ./scripts/qa.mjs codegen",
    "ui": "node ./scripts/qa.mjs tests --ui",
    "typecheck": "tsc --noEmit",
    "test:par": "node ./scripts/catalog-coverage.mjs --require-nonzero && node ./scripts/qa.mjs tests/generated/platform/par/catalogParLinks.spec.ts",
    "test:reporters": "node --test ./tests/unit/reporting/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.5.2",
    "typescript": "^6.0.2"
  }
}
