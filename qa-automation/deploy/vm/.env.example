COMPOSE_PROJECT_NAME=livelabs-qa

# Keep loopback for SSH-tunnel inspection. On the permanent VM, use only its
# private VPN address. Do not bind this portal to a public interface.
QA_BIND_ADDRESS=127.0.0.1
QA_HTTPS_PORT=32443
QA_PUBLIC_HOST=qa-vm.internal.example
QA_PUBLIC_URL=https://qa-vm.internal.example:32443

JENKINS_ADMIN_USER=qa-admin
QA_REPORT_USER=qa-reviewer
QA_GIT_URL=https://github.com/oracle-livelabs/common.git
QA_GIT_BRANCH=*/main
QA_GIT_CREDENTIAL_ID=

# Jenkins uses these schedules after startup. The exact minute is hashed so
# multiple Jenkins jobs do not all start at the same time.
QA_NIGHTLY_CRON=H H(1-4) * * *
QA_PAR_CRON=H H(1-4) * * 0

# Optional private-content sign-in target. Credentials stay in ./secrets.
QA_AUTH_TARGET_URL=
QA_BASE_URL=

# Optional private Object Storage publishing. Instance principal is recommended.
QA_OBJECT_STORAGE_NAMESPACE=
QA_OBJECT_STORAGE_BUCKET=
QA_OBJECT_STORAGE_PREFIX=livelabs-qa
QA_OCI_AUTH_MODE=instance_principal