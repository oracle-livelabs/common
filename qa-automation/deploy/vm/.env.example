COMPOSE_PROJECT_NAME=livelabs-qa

# Deployment-specific addresses and ports are intentionally not committed.
# The internal provisioning runbook must provide approved values.
QA_BIND_ADDRESS=127.0.0.1
QA_HTTPS_PORT=
QA_JENKINS_INTERNAL_PORT=
QA_PORTAL_INTERNAL_PORT=
QA_PUBLIC_HOST=
QA_PUBLIC_URL=

# Temporary local authentication. Generated values are written only under the
# ignored deploy/vm/secrets directory on the VM.
JENKINS_ADMIN_USER=qa-admin
QA_REPORT_USER=qa-reviewer

QA_GIT_URL=https://github.com/oracle-livelabs/common.git
QA_GIT_BRANCH=*/main
QA_GIT_CREDENTIAL_ID=

# Jenkins uses these schedules after startup. Keep the permanent values in the
# internal deployment configuration.
QA_NIGHTLY_CRON=
QA_PAR_CRON=

QA_AUTH_TARGET_URL=
QA_BASE_URL=

# Optional private Object Storage publishing through the VM instance principal.
QA_OBJECT_STORAGE_NAMESPACE=
QA_OBJECT_STORAGE_BUCKET=
QA_OBJECT_STORAGE_PREFIX=livelabs-qa
QA_OCI_AUTH_MODE=instance_principal
